# ==============================================================================
# FounderLink Environment Variables Example
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database & Cache
MONGO_URI=mongodb://localhost:27017/founderlink
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_access_key_change_in_production_123456
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_789012
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_r2_or_s3_access_key_id
STORAGE_SECRET_KEY=your_r2_or_s3_secret_access_key
STORAGE_BUCKET=founderlink-uploads
STORAGE_PUBLIC_URL=https://uploads.founderlink.com

# Client Public Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
